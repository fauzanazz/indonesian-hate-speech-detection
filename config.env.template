# Environment Variables Template for Indonesian Toxicity Detection API
# Copy this file to config.env and customize as needed
# For Docker: docker-compose --env-file config.env up

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_CORS=true

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=toxic_vectors

# For Docker deployment, use service name
# QDRANT_HOST=qdrant

# ============================================
# Model Paths (relative to project root)
# ============================================
MODEL_DIR=models
BASIC_MODEL_PATH=models/tfidf
CONTEXTUAL_MODEL_PATH=models/bilstm
SOCIOLINGUISTIC_MODEL_PATH=models/transformer
ENSEMBLE_CONFIG_PATH=configs/models/ensemble.yaml

# ============================================
# Search Configuration
# ============================================
SEARCH_ENCODER_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
SEARCH_MAX_SEQ_LENGTH=128
SEARCH_TOP_K=20
SEARCH_SCORE_THRESHOLD=0.7

# ============================================
# Counter Speech Configuration
# ============================================
COUNTER_SPEECH_MODEL=Wikidepia/IndoT5-base
COUNTER_SPEECH_MAX_LENGTH=512
COUNTER_SPEECH_NUM_BEAMS=4

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=1 week

# ============================================
# Development Settings
# ============================================
# Uncomment for development mode
# DEBUG=true
# RELOAD=true

